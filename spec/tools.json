  {
    "name": "order_bandwidth_upgrade",
    "title": "带宽升级下单",
    "description": "会从账户余额扣费。为时长类子账号升级带宽，先用 bandwidth_upgrade_price 试算并向用户确认。",
    "readOnly": false,
    "destructive": true,
    "method": "POST",
    "path": "/externalapi/product_order/createBandwidthUpgradeOrder",
    "fixed": {
      "pay_method": "balance"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "subAccountIds": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "子账号"
          }
        },
        "bandwidth_num": {
          "type": "integer",
          "description": "要升级的带宽"
        },
        "product_type_id": {
          "type": "integer",
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8
          ]
        }
      },
      "required": [
        "subAccountIds",
        "bandwidth_num",
        "product_type_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "order_buy_dynamic",
    "title": "购买动态住宅流量",
    "description": "会从账户余额扣费。购买动态住宅流量：产品 1 按 GB 购买，num 为 GB 数（1-1024）；产品 6 为包月，bill_timelen 指定月数。下单前先用 product_unit_price 查价、user_info 查余额，并向用户确认。",
    "readOnly": false,
    "destructive": true,
    "method": "POST",
    "path": "/externalapi/product_order/createProductBuyOrder",
    "inputSchema": {
      "type": "object",
      "properties": {
        "product_type_id": {
          "type": "integer",
          "description": "产品类型：1=动态住宅流量（不限时长），6=动态住宅流量（包月）",
          "enum": [
            1,
            6
          ]
        },
        "num": {
          "type": "integer",
          "description": "需要购买的流量数量。单位：GB。范围：1-1024GB之间"
        },
        "bill_timelen": {
          "type": "integer",
          "description": "包月有效时长：1=30天，2=90天，3=180天；产品 6 必填，产品 1 忽略"
        }
      },
      "required": [
        "product_type_id",
        "num"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "order_buy_test_ip",
    "title": "购买时长测试 IP",
    "description": "会从账户余额按时长扣费。购买短期测试用的时长 IP，用于自有平台给用户试用。",
    "readOnly": false,
    "destructive": true,
    "method": "POST",
    "path": "/externalapi/product_order/createTestOrder",
    "inputSchema": {
      "type": "object",
      "properties": {
        "product_type_id": {
          "type": "integer",
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8
          ]
        },
        "num": {
          "type": "integer",
          "description": "需要短期购买的子账号数量。范围：1-20之间"
        },
        "timelen": {
          "type": "integer",
          "description": "时长计费：固定为12小时"
        },
        "agree": {
          "type": "string",
          "description": "协议：SOCKS5，HTTP，HTTPS"
        },
        "country": {
          "type": "string",
          "description": "静态住宅国家编码code。国家用 ISO 3166-1 二字码，如 US"
        },
        "city": {
          "type": "string",
          "description": "静态住宅城市名称,不传默认随机。"
        },
        "bandwidth_num": {
          "type": "integer",
          "description": "不传默认是5M，可传值10和15,10M按每条人民币10元,15M按每条人民币15元计费"
        }
      },
      "required": [
        "product_type_id",
        "num",
        "timelen",
        "agree",
        "country"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "order_buy_time_ip",
    "title": "购买时长 IP",
    "description": "会从账户余额扣费。购买静态住宅（2/3/4）或数据中心（8）时长 IP，num 为 IP 数量（1-300）。下单前先用 stock_check 检测库存、product_unit_price 查价，并向用户确认。",
    "readOnly": false,
    "destructive": true,
    "method": "POST",
    "path": "/externalapi/product_order/createProductBuyOrder",
    "inputSchema": {
      "type": "object",
      "properties": {
        "product_type_id": {
          "type": "integer",
          "description": "产品类型：2=静态住宅（普通），3=静态住宅（原生），4=静态住宅（运营商原生），8=数据中心",
          "enum": [
            2,
            3,
            4,
            8
          ]
        },
        "num": {
          "type": "integer",
          "description": "需要购买的子账号数量。范围：1-300之间"
        },
        "timelen": {
          "type": "integer",
          "description": "时长计费类型：0=7天，1=30天，2=90天，3=180天，4=360天，5=3天"
        },
        "agree": {
          "type": "string",
          "description": "协议：SOCKS5，HTTP，HTTPS"
        },
        "country": {
          "type": "string",
          "description": "静态住宅国家编码code，例如：US。可从静态住宅（普通非原生）国家列表获取。国家用 ISO 3166-1 二字码，如 US"
        },
        "city": {
          "type": "string",
          "description": "静态住宅城市名称。在静态住宅（普通非原生）城市列表可获取城市名称。不传默认随机。"
        },
        "appoint_ip": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ip_str": {
                "type": "string",
                "description": "指定ip段"
              },
              "count": {
                "type": "integer",
                "description": "指定数量"
              }
            },
            "additionalProperties": false
          }
        },
        "exclude_ip_str": {
          "type": "string",
          "description": "排除ip段，多个以英文逗号分隔"
        },
        "bandwidth_num": {
          "type": "integer",
          "description": "带宽值"
        },
        "remark": {
          "type": "string",
          "description": "创建的子账号备注"
        },
        "use_ip_port": {
          "type": "integer",
          "description": "是否开启ip端口连接:0=不开启,1=开启(默认为0)"
        },
        "random_account_password": {
          "type": "integer",
          "description": "是否生成随机账号密码:0=否,1=是(默认为0)"
        }
      },
      "required": [
        "product_type_id",
        "num",
        "timelen",
        "agree",
        "country"
      ],
      "additionalProperties": false
    }
  },
